# کلاس اصلی پلاگین (مثل byTaha در فایل اصلی)
# ============================================
class byPing(Plugin):
    """پلاگین ساده برای نمایش پینگ در بازی BombSquad"""
    
    def __init__(self):
        # پیام خوش‌آمدگویی
        from bauiv1 import apptimer
        apptimer(5, lambda: push("📡 Ping Monitor Loaded! Click 'Ping' in Party Menu", color=(0, 1, 1)))
        
        # اضافه کردن دکمه به منوی مهمانی
        self.patch_party_window()
    
    def patch_party_window(self):
        """اضافه کردن دکمه Ping به منوی مهمانی (مثل فایل اصلی)"""
        from bauiv1lib import party
        
        # ذخیره تابع اصلی
        original_init = party.PartyWindow.__init__
        
        def new_init(self, *args, **kwargs):
            # اجرای تابع اصلی
            result = original_init(self, *args, **kwargs)
            
            # اضافه کردن دکمه Ping
            bw(
                parent=self._root_widget,
                position=(self._width - 80, self._height - 48),
                size=(70, 25),
                label='📡',
                icon=None,
                on_activate_call=lambda: PingButton(self._root_widget),
                color=(0.2, 0.6, 0.8),
                textcolor=(1, 1, 1),
                text_scale=0.6,
                button_type='square'
            )
            
            # اضافه کردن برچسب زیر دکمه
            tw(
                parent=self._root_widget,
                text='Ping',
                position=(self._width - 80, self._height - 75),
                h_align='center',
                scale=0.4,
                color=(0.8, 0.8, 1)
            )
            
            return result
        
        # جایگزینی تابع
        party.PartyWindow.__init__ = new_init

# ============================================
# تابع ورودی پلاگین (مورد نیاز BombSquad)
# ============================================
def ba_plugin():
    return byPing()
